# Загружаем строго 8-битную (Q8) версию Gemma 4 12B
FROM gemma4:12b-it-q8_0

# 1. Лимиты контекста для глубокого анализа кодовых баз
PARAMETER num_ctx 65536
PARAMETER num_predict 8192

# 2. Настройка памяти для RTX 4080 (16GB). 
# Оставляем num_gpu пустым (или ставим 0 для авто), чтобы Ollama сама закинула 
# ВСЕ слои модели во VRAM. ОЗУ DDR5 здесь простаивает — всё работает на GPU.
PARAMETER use_mmap false

# 3. Официальный сэмплинг от Google для кодинга без галлюцинаций
PARAMETER temperature 0.1
PARAMETER top_p 0.95
PARAMETER top_k 64
PARAMETER repeat_penalty 1.1