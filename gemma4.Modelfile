FROM gemma4:26b

# Жестко ограничиваем контекст, чтобы модель + KV-кэш занимали ~13-14 ГБ VRAM
PARAMETER num_ctx 12288
PARAMETER num_predict 4096

# Настройки генерации для точного кодинга без "галлюцинаций"
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1
PARAMETER use_mmap true
